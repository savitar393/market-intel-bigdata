{
  "id": null,
  "uid": "market-intel-overview",
  "title": "Market Intel - System Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "type": "stat",
      "title": "API Requests",
      "id": 1,
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 4},
      "targets": [
        {
          "expr": "sum(rate(market_intel_api_requests_total[1m]))",
          "legendFormat": "req/s",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "API Request Duration p95",
      "id": 2,
      "gridPos": {"x": 6, "y": 0, "w": 9, "h": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(market_intel_api_request_duration_seconds_bucket[1m])) by (le, path))",
          "legendFormat": "{{path}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Active WebSocket Connections",
      "id": 3,
      "gridPos": {"x": 15, "y": 0, "w": 5, "h": 4},
      "targets": [
        {
          "expr": "sum by (symbol) (market_intel_websocket_active_connections) or vector(0)",
          "legendFormat": "connections",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Market Avg Ingest Latency",
      "id": 4,
      "gridPos": {"x": 0, "y": 8, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_market_avg_ingest_latency_seconds",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Market Ingest Freshness",
      "id": 5,
      "gridPos": {"x": 10, "y": 8, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_market_ingest_freshness_seconds",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Prediction Freshness",
      "id": 6,
      "gridPos": {"x": 0, "y": 16, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_prediction_freshness_seconds",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Latest Prediction Confidence",
      "id": 7,
      "gridPos": {"x": 10, "y": 16, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_latest_prediction_confidence",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alert Rows in Window",
      "id": 8,
      "gridPos": {"x": 0, "y": 24, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_alert_rows_window",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Alert Freshness",
      "id": 9,
      "gridPos": {"x": 10, "y": 24, "w": 10, "h": 8},
      "targets": [
        {
          "expr": "market_intel_alert_freshness_seconds",
          "legendFormat": "{{symbol}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    }
  ]
}
