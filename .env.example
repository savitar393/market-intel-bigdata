# Never commit your real API keys.
DATABENTO_API_KEY=YOUR_API_KEY_HERE
FINNHUB_API_KEY=YOUR_API_KEY_HERE

# First validation target.
DATABENTO_DATASET=XNAS.ITCH
DATABENTO_SCHEMA=ohlcv-1m
DATABENTO_SYMBOLS=AAPL,MSFT,NVDA
DATABENTO_START=2024-05-21T15:00
DATABENTO_END=2024-05-21T15:05

YFINANCE_SYMBOLS=AAPL,MSFT,NVDA
YFINANCE_MAX_MESSAGES=20

FINNHUB_SYMBOLS=AAPL,MSFT,NVDA
FINNHUB_LOOKBACK_DAYS=7

# Cassandra local serving store
CASSANDRA_HOSTS=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=market_intel

# Telegram alert notifications
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_TELEGRAM_CHAT_ID
# MLflow experiment tracking
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=market-intel-baselines

# Finnhub WebSocket fallback producer
FINNHUB_WS_SYMBOLS=AAPL,MSFT,NVDA,BINANCE:BTCUSDT
FINNHUB_WS_MAX_MESSAGES=20

# Online live inference
ONLINE_MODEL_PATH=data/model_artifacts/online_serving/logistic_regression_online.json
ONLINE_INFERENCE_SYMBOLS=AAPL,MSFT,NVDA,AMZN,TSLA
ONLINE_INFERENCE_GROUP_ID=online-market-inference
ONLINE_INFERENCE_MAX_PREDICTIONS=0

# Free GDELT news source
GDELT_NEWS_SYMBOLS=AAPL,MSFT,NVDA,AMZN,TSLA
GDELT_NEWS_TIMESPAN=7d
GDELT_MAX_EVENTS_PER_SYMBOL=5

# Prefect ML refresh orchestration
MODEL_SYMBOLS=AAPL,MSFT,NVDA,AMZN,TSLA
CLASSIFICATION_LABEL_COLUMN=target_direction
PREDICTION_ALERT_THRESHOLD=0.47
FINAL_MODEL_SERVING_CONFIG=config/final_model_serving.json
PREFECT_ML_REFRESH_DEPLOYMENT_NAME=scheduled-ml-refresh
PREFECT_ML_REFRESH_CRON=0 */6 * * *

# Daily historical context features
DAILY_BACKFILL_SYMBOLS=AAPL,MSFT,NVDA,AMZN,TSLA
DAILY_BACKFILL_START=2010-01-01
DAILY_BACKFILL_OUTPUT_PATH=data/processed/daily_stock_prices/daily_stock_prices.csv
DAILY_STOCK_CSV_PATH=data/processed/daily_stock_prices/daily_stock_prices.csv
DAILY_FEATURE_PATH=data/features/daily_stock_features
DAILY_LATEST_CONTEXT_PATH=data/features/daily_stock_context_latest.json
